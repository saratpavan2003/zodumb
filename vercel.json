{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/horoscope.js": {
      "memory": 128,
      "maxDuration": 30
    },
    "api/sicknote.js": {
      "memory": 128,
      "maxDuration": 30
    },
    "api/nomoney.js": {
      "memory": 128,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/sick", "destination": "/sick.html" },
    { "source": "/money", "destination": "/money.html" }
  ]
}
